# TrafficFlow AI Backend Environment Configuration (Template / Placeholders Only)

# Environment Mode: Explicitly set "development" or "testing" for local runs; "production" for live deployments.
# CRITICAL: Production mode will fail safely if ENVIRONMENT is unset or not set to a recognized safe mode,
# or if JWT_SECRET is unset or using an insecure placeholder. Implicit development fallback keys are strictly prohibited in production.
ENVIRONMENT=development

# Server Settings
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./data/trafficfl.db

# Security & Authentication
# IMPORTANT: In production, JWT_SECRET must be set to a secure random string (e.g. openssl rand -hex 32).
# Production mode will fail to start if JWT_SECRET is unset or using a default placeholder.
JWT_SECRET=dev-trafficfl-jwt-secret-placeholder-change-in-production-2026
SECRET_KEY=dev-trafficfl-jwt-secret-placeholder-change-in-production-2026
ALLOW_DEMO_LOGIN=true
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Background Traffic Polling & Telemetry Refresh
TRAFFIC_BACKGROUND_POLLING=true
TRAFFIC_REFRESH_INTERVAL_SECONDS=300
MIN_COLLECTION_INTERVAL_SECONDS=60.0

# TomTom Traffic Flow & Incident Details APIs
# Mode: "live" (connects to genuine TomTom APIs) or "simulated" (calibrated Delhi NCR stream)
TRAFFIC_PROVIDER_MODE=simulated
TOMTOM_API_KEY=YOUR_TOMTOM_API_KEY_HERE
TOMTOM_BASE_URL=https://api.tomtom.com/traffic/services/4
TOMTOM_INCIDENTS_BASE_URL=https://api.tomtom.com/traffic/services/5/incidentDetails
TOMTOM_DELHI_BBOX=77.05,28.45,77.35,28.70
TOMTOM_CACHE_TTL_SECONDS=300
TOMTOM_TIMEOUT_SECONDS=5.0
TOMTOM_MAX_RETRIES=2

# Machine Learning Artifact Persistence
MODELS_DIR=./data/models

# Optional LLM API Keys (Leave blank to use data-grounded bilingual analytical reasoning)
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Configuration (comma-separated allowed origins for frontend applications)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
